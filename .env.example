# Copie este archivo como .env y ajuste los valores.

DJANGO_DEBUG=True
# Genere una clave con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (requerido por la práctica)
DB_ENGINE=postgresql
DB_NAME=visionaula
DB_USER=postgres
DB_PASSWORD=cambie-esta-clave
DB_HOST=localhost
DB_PORT=5432

# Parámetros de visión (opcionales)
VISION_MATCH_THRESHOLD=0.40
VISION_DETECTION_SCORE=0.80
VISION_MIN_FACE_SIZE=40
VISION_CONFIRM_FRAMES=3
VISION_CONFIRM_WINDOW_SECONDS=4
VISION_MAX_SAMPLES=10
